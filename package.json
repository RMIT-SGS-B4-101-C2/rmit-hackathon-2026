{
    "name": "research-consent-vault",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --webpack",
        "build": "next build --webpack",
        "start": "next start",
        "init": "node scripts/run-tide.mjs init",
        "tide:doctor": "node scripts/run-tide.mjs doctor",
        "typecheck": "tsc --noEmit",
        "db:generate": "prisma generate",
        "db:validate": "prisma validate",
        "db:migrate": "prisma migrate dev",
        "db:studio": "prisma studio",
        "services:up": "docker compose up -d postgres",
        "services:down": "docker compose down",
        "postinstall": "prisma generate",
        "test:security": "playwright test",
        "test:security:ui": "playwright test --ui",
        "test:callback": "node scripts/check-login-callback.mjs"
    },
    "dependencies": {
        "@prisma/adapter-pg": "7.10.1",
        "@prisma/client": "7.10.1",
        "@tidecloak/nextjs": "0.14.40",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "dotenv": "18.0.8",
        "jose": "^6.0.0",
        "lucide-react": "1.61.0",
        "next": "16.4.2",
        "pg": "8.23.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwind-merge": "3.7.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "^22.0.0",
        "@types/pg": "8.23.1",
        "@types/react": "^19.0.0",
        "prisma": "7.10.1",
        "tailwindcss": "4.3.3",
        "typescript": "^5.0.0"
    },
    "engines": {
        "node": ">=24 <25"
    }
}
